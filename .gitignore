# dependencies
node_modules/
package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
/out/
/dist/

# production
/build

# personal knowledge corpus (resume, originals — keep local only)
/data/doc/

# Mem0 / LangMem / LangGraph checkpointer 本地存储
/data/memory/*
!/data/memory/.gitkeep
!/data/memory/mem0/.gitkeep
!/data/memory/langgraph/.gitkeep

# 入库 CLI 日志
/logs/*
!/logs/.gitkeep

# eval 报告（eval:run 本地生成）
/data/eval/reports/*
!/data/eval/.gitkeep
!/data/eval/reports/.gitkeep

# 门禁运行日志 / Playwright 产物（总报表 GATE-REPORT.md 与 reports/*-report.* 保留）
.gate-logs/
/reports/playwright/
/reports/vitest-raw.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# sqlite (Prisma local)
/packages/db/prisma/*.db
/packages/db/prisma/*.db-journal
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
**/next-env.d.ts

/packages/db/src/generated/

# python
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/*.pyc

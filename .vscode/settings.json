{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "nodeTdd.activateOnStartup": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/brain/.venv/bin/python",
  "pylint.args": ["--max-line-length=120"],
  "cSpell.words": ["ollama", "qdrant"],
  "python.analysis.extraPaths": [
    "${workspaceFolder}/apps/brain/packages/agentflow/src",
    "${workspaceFolder}/apps/brain/packages/kernel/src",
    "${workspaceFolder}/apps/brain/packages/corpus/src",
    "${workspaceFolder}/apps/brain/packages/memory/src",
    "${workspaceFolder}/apps/brain/apps/api/src",
    "${workspaceFolder}/apps/brain/apps/worker/src"
  ]
}

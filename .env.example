# Environment variables — 统一放在仓库根目录 `.env`

DATABASE_URL="file:./packages/db/prisma/dev.db"

# --- 服务端口（改这里即可；完整 URL 变量可覆盖 HOST+PORT）---
PORT=3000
BRAIN_SERVICE_HOST=127.0.0.1
# Python Brain 监听这个端口（网页的 BRAIN_SERVICE_URL 也指向它）
BRAIN_SERVICE_PORT=3001
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# 语料 dense+sparse；Mem0 dense-only。镜像 qdrant/qdrant:v1.15.5（加权 RRF）

# --- Redis（检索 cache / BullMQ 队列；Docker 内用 redis://redis:6379）---
# 本地 pnpm dev：未设 REDIS_URL 且 REDIS_ENABLED≠1 时自动用进程 memory fallback
# REDIS_ENABLED=1
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_KEY_PREFIX=fambrain
# REDIS_URL="redis://127.0.0.1:6379"
# URL 带 /N 时优先于 REDIS_DB，例如 redis://127.0.0.1:6379/2
# DEV_REDIS_AUTO_START=1  # pnpm dev 时 Redis 不可达则 docker compose up redis（默认 1）

# --- 执行控制面 / 单槽预算（docs/06-architecture-control-plane.md）---
# 语义规划仍归 Intake / 单槽 L1；此处只调「结构预算」初值（全槽统一，非场景硬编码）。
# 未设置时默认：maxAttempts=2，deadlineMs=60000。
#
# SLOT_MAX_ATTEMPTS：单槽最多执行次数（含首次；严格上限，全局 B 也不能加成第 3 次）
# SLOT_MAX_ATTEMPTS=2
#
# SLOT_DEADLINE_MS：单槽墙钟超时（毫秒）。工人内 Promise.race；到点该槽 skipped(timeout)，其它槽照常 Fan-out 汇合
# SLOT_DEADLINE_MS=60000
#
# SLOT_GLOBAL_REBATCH_ENABLED：Join 后全局 B（结构化补丁再批失败槽 ≤1）。未设/1=开；0/false=关
# SLOT_GLOBAL_REBATCH_ENABLED=1

# --- Pipeline cache 开关（=1 关闭；默认均开启）---
# 同问短路：normalize 相同 user 问 → 复用上轮 assistant 答（repeat-question-guard）
# REPEAT_QUESTION_CACHE_DISABLED=0
# 检索结果 cache（corpusUserId + searchQuery + queryType）
# RETRIEVAL_CACHE_DISABLED=0
# RETRIEVAL_CACHE_TTL_MS=900000
# RETRIEVAL_CACHE_MAX_ENTRIES=256
# composite 子问终稿 cache（会话 facet + 增量 composite）
# COMPOSITE_ANSWER_CACHE_DISABLED=0
# COMPOSITE_ANSWER_CACHE_TTL_MS=900000
# COMPOSITE_ANSWER_CACHE_MAX_ENTRIES=128
# keyPrefix 默认 ${REDIS_KEY_PREFIX}:composite-answer

# --- 检索结果 cache（D5-2）· 见上 ---

# --- Pipeline 异步队列（BullMQ；需 Redis + dev:worker）---
# 未设时默认 ${REDIS_KEY_PREFIX}-pipeline / ${REDIS_KEY_PREFIX}:pipeline:events
# PIPELINE_QUEUE_ENABLED=0
# PIPELINE_QUEUE_NAME=fambrain-pipeline
# PIPELINE_QUEUE_CONCURRENCY=2
# PIPELINE_QUEUE_JOB_TTL_MS=3600000
# PIPELINE_QUEUE_EVENT_PREFIX=fambrain:pipeline:events
# 原文库语料化队列（可选；关闭时聊天路径同步 materialize/purge）
# CORPUS_QUEUE_ENABLED=0
# CORPUS_QUEUE_NAME=fambrain-corpus
# CORPUS_QUEUE_CONCURRENCY=2
# E2E（勿把密码写进文档正文）
# E2E_BASE_URL=http://127.0.0.1:3000
# E2E_USER=panzhanfei
# E2E_PASSWORD=

# 可选：直接写完整 URL（设置后优先于 HOST+PORT）
# BRAIN_SERVICE_URL="http://127.0.0.1:3001"

# 可选：直接写完整 URL（设置后优先于 HOST+PORT）
# 本机 pnpm dev：可指向局域网台式机 Ollama，例如 http://192.168.1.100:11434
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# QDRANT_URL="http://127.0.0.1:6333"

# --- 模型 ---
OLLAMA_MODEL="qwen2.5:14b"
# OLLAMA_MODEL_INTAKE_COORDINATOR="qwen2.5:14b"
# OLLAMA_MODEL_EMBED="nomic-embed-text"

# 在线 Chat（Intake / Analyst / 摘要 / 全局 B / LangMem / 抽记忆 / DAG 填表）
# 默认 ollama。改 openai 后须配 OPENAI_API_KEY（或 DEEPSEEK_API_KEY）；失败不会回落本地模型
# embed / 图片 OCR / Mem0 向量仍走 Ollama
# CHAT_PROVIDER=ollama
# CHAT_PROVIDER=openai
# OPENAI_BASE_URL="https://api.deepseek.com"
# OPENAI_MODEL="deepseek-v4-flash"
# OPENAI_API_KEY=""
# DEEPSEEK_API_KEY=""

# 入库 embed：同时进行的批次数 / 每批 chunk 数（默认 3 / 8）
# INDEX_EMBED_CONCURRENCY=3
# INDEX_EMBED_BATCH_SIZE=8

# 文档解析：批量解析并发数（默认 2）
# DOC_PARSE_CONCURRENCY=2
# 图片 OCR 使用的 Ollama 视觉模型（默认沿用 OLLAMA_MODEL；建议 llava 等 vision 模型）
# OLLAMA_MODEL_VISION="llava"

# Mem0 跨会话记忆 / LangMem 会话摘要（默认开启；需 Ollama + Qdrant）
# MEM0_ENABLED=true
# MEM0_HISTORY_DB_PATH="data/memory/mem0/history.db"
# 图 Pause/Resume（官方 SqliteSaver；默认 data/memory/langgraph/checkpoints.db）
# LANGGRAPH_CHECKPOINT_PATH="data/memory/langgraph/checkpoints.db"
# FAMBRAIN_CHECKPOINT_BACKEND=sqlite
# MEM0_QDRANT_COLLECTION="fambrain_user_memories"
# MEM0_SEARCH_LIMIT=5
# LANGMEM_ENABLED=true
# LANGMEM_SUMMARIZE_AFTER_TURNS=8
# LANGMEM_KEEP_RECENT_TURNS=4

# 静默用户记忆（轮次后独立 LLM 抽结构化事实 → Mem0；默认关闭）
# USER_MEMORY_AUTO_LEARN_ENABLED=false
# USER_MEMORY_AUTO_LEARN_MIN_CONFIDENCE=0.85
# OLLAMA_MODEL_USER_MEMORY_EXTRACT=""
# OLLAMA_STREAM_THINK="true"

# LangSmith 链路追踪（Web UI：https://smith.langchain.com）
# 配置 API Key 后默认开启；设 LANGSMITH_TRACING=false 可关闭
# LANGSMITH_API_KEY="lsv2_pt_..."
# LANGSMITH_PROJECT="fambrain"
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# 离线 parse:documents 默认语料归属（Web 登录用户会自动解析，一般无需配置）
# FAMBRAIN_CORPUS_USER_ID=""
# FAMBRAIN_ACTOR_USER_ID=""

# 联网搜索（ToolOrchestrator search_web；未配置时 corpus-first 后返回 disabled）
# TAVILY_API_KEY=""
# FAMBRAIN_TAVILY_API_KEY=""
# FAMBRAIN_WEB_SEARCH_ENABLED=1

# 在线翻译（toolId=translate_text；有道智云文本翻译 NMT）
# FAMBRAIN_TRANSLATE_PROVIDER=youdao
# YOUDAO_APP_KEY=""
# YOUDAO_APP_SECRET=""

# JWT（生产必填，长度 >= 24）。Node 与 Python 后端共用同一把密钥。
# JWT_SECRET=""

# --- Python 后端（apps/brain）---
# 账号和会话用上面的 DATABASE_URL（Prisma SQLite），与网站同一份库。
# FAMBRAIN_HOST=127.0.0.1
# BRAIN_PY_PORT=3011
# FAMBRAIN_ENV=development

# 可选：LOGIN_/REGISTER_/LOGOUT_RATE_LIMIT_*、JWT_RENEW_BEFORE_EXPIRY_SEC、
# TRUST_PROXY_HEADERS、SECURITY_ENABLE_HSTS、FAMBRAIN_MEMBERSHIP_AUDIT_ID_SUFFIX
